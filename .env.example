# Copy this file to .env and fill in the key. Never put a real key in this file.
# One OpenAI key runs both typed chat and voice.
OPENAI_API_KEY=

# Optional
# JARVIS_MODEL=gpt-6-luna
# JARVIS_USER_NAME=sir

# Voice (OpenAI GPT-Live). Billed per second of conversation.
# JARVIS_VOICE=marin
# JARVIS_VOICE_BACKEND_MODEL=gpt-6-luna
